# Deployment environment: dev, prod, test, staging, etc.
# Determines which secrets file is used: secrets/<DEPLOYMENT>.env
DEPLOYMENT=dev

# Root directory for relative path resolution ('.' = directory of .env file, or absolute path)
# If set to '.', paths in BACKUP_DIR and DATABASE_URL are relative to the .env directory
ROOT_DIR=.

# Database backup directory (relative to ROOT_DIR if not absolute)
BACKUP_DIR=backups

# Database URL (SQLite paths relative to ROOT_DIR if not absolute, PostgreSQL URLs unchanged)
# Examples:
#   SQLite relative: sqlite:///./stem_league_data.db
#   SQLite absolute: sqlite:////absolute/path/to/db.db
#   PostgreSQL: postgresql://user:pass@localhost/dbname
DATABASE_URL=sqlite:///./stem_league_data.db
